GROQ_API_KEY=
# HUGGINGFACE_API_TOKEN=
QDRANT_API_KEY= # leave empty to use local Qdrant
QDRANT_URL= # http://localhost:6333 # if local Qdrant, otherwise provide the Qdrant Cloud URL
QDRANT_PORT= # optional; defaults to 443 for HTTPS Cloud URLs and 6333 for local HTTP URLs
QDRANT_COLLECTION_NAME=
# Optional for direct `docker compose` use. `make compose` detects these automatically.
# LOCAL_UID=1000
# LOCAL_GID=1000
EMBEDDING_API_URL=
COHERE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_PROVIDER=openai
GENERATION_MODEL=gpt-4.1
GENERATION_MODEL_PROVIDER=openai
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-tracing

# Shared catalogue for uploads and arXiv. arXiv discovery remains opt-in and uses no LLM.
# Host commands use localhost; Compose overrides the hostname to postgres.
PAPERS_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/papers
# Local demo credentials only. Use secret-managed credentials outside local development.
PAPERS_DB_PASSWORD=rag
PAPERS_COLLECTION=arxiv_papers_v1
ARXIV_CATEGORIES=astro-ph.GA
# Comma-separated phrases; ANY phrase in title/abstract, AND a matching category.
# Empty means all papers in the selected categories (no topic filtering).
ARXIV_TOPIC_TERMS=star cluster,stellar cluster,globular cluster,open cluster,young massive cluster,nuclear star cluster
# Set an identifiable User-Agent with your contact address before scheduled use.
ARXIV_USER_AGENT=rag-demo/0.2 (scientific-paper research demo)
ARXIV_BACKFILL_DAYS=7
ARXIV_DAILY_LIMIT=10
ARXIV_MAX_ATTEMPTS=3
ARXIV_MAX_PDF_MB=30
ARXIV_MAX_CHUNKS=1000
# LOCAL for host/bind-mounted local demo; AZURE for ephemeral deployments.
PAPERS_STORAGE_MODE=LOCAL
PAPERS_ARTIFACT_DIR=data/paper_artifacts
# For AZURE, create this private container and set AZURE_STORAGE_CONNECTION_STRING.
PAPERS_AZURE_CONTAINER=rag-papers

# Optional durable daily runner / Airflow. No schedule is enabled by default.
# A fixed selection of ARXIV_DAILY_LIMIT builds per UTC date; at most this many
# attempts per selected build/date, also bounded by ARXIV_MAX_ATTEMPTS globally.
# This is a processing bound, NOT a strict dollar/token cap.
PAPERS_RUN_MAX_ATTEMPTS=2
# Optional for local use: leave both URLs empty to run with logs/summaries only.
# Set true in a monitored deployment to require both endpoints before ingestion.
PAPERS_REQUIRE_MONITORING=false
# Configured URLs must use HTTPS and are secrets.
# Failure endpoint: accepts a generic JSON POST (not a Slack-specific payload).
PAPERS_ALERT_WEBHOOK_URL=
# External dead-man monitor: GET on success. Configure daily cadence + grace there.
# This detects scheduler/host outages when no failure webhook can run.
PAPERS_HEARTBEAT_URL=
# LOCAL Airflow metadata DB only; change before non-local deployment.
AIRFLOW_DB_PASSWORD=airflow-local-only
